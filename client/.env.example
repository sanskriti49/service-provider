# Origin of the API server. Leave unset for local dev and it falls back to
# http://localhost:3000. Must be set for any deployed build.
VITE_API_URL=

# Optional. Google sign-in is hidden when this is blank.
VITE_GOOGLE_CLIENT_ID=

# Optional integrations.
VITE_RAZORPAY_KEY_ID=
VITE_TURNSTILE_SITE_KEY=
