# Leave blank for local development to use Vite's /api and /socket.io proxies.
# Set the backend origin for deployments that do not provide a same-origin proxy.
VITE_API_URL=

# Optional. Google sign-in is hidden when this is blank.
VITE_GOOGLE_CLIENT_ID=

# Optional integrations.
VITE_RAZORPAY_KEY_ID=
VITE_TURNSTILE_SITE_KEY=
