{
	"name": "taskgenie",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "node scripts/dev.cjs",
		"test:dev": "node --test scripts/dev.test.cjs",
		"build": "npm run build --prefix client",
		"test": "npm run test:dev && npm run test --prefix server && npm run test --prefix client",
		"verify:engineering": "node server/scripts/verifyEngineering.js",
		"lint": "npm run lint --prefix client",
		"reset-db": "npm --prefix server run reset-db",
		"seed-db": "npm --prefix server run seed-db",
		"seed-services": "npm --prefix server run seed-services",
		"ensure-providers": "npm --prefix server run ensure-providers",
		"ensure-admin": "npm --prefix server run ensure-admin"
	},
	"devDependencies": {
		"concurrently": "^9.1.2"
	}
}
