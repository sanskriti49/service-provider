# Runtime
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Database
# Set disable only for a trusted local database. Use verify-full for remote TLS.
DB_SSL_MODE=disable
# Optional PEM CA bundle for verify-full. Overrides Node's default trust store.
# DB_SSL_CA_FILE=/path/to/postgres-ca.pem
# DATABASE_URL takes precedence over the discrete settings below.
DATABASE_URL=
# Discrete settings are used when DATABASE_URL is empty.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=taskgenie
DB_USER=postgres
DB_PASSWORD=

# Auth. Required: the server signs and verifies every JWT with this.
JWT_SECRET=change_me
GOOGLE_CLIENT_ID=

# KYC uses local private storage only, for synthetic development documents.
# Create this directory outside the repository and set an absolute path.
# KYC_STORAGE_DRIVER=local
# KYC_PRIVATE_DIRECTORY=/absolute/path/outside/taskgenie
# KYC is intentionally unavailable on Render and in production.

# Optional legacy profile-image storage uses AWS_REGION, AWS_S3_BUCKET or
# S3_BUCKET_NAME, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# AWS_ENDPOINT_URL_S3 or S3_ENDPOINT, and S3_PUBLIC_URL or R2_PUBLIC_URL.
# These are unrelated to KYC and can incur charges; leave them unset for local use.

# Optional legacy integrations. Email-dependent flows need a working mail transport.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TURNSTILE_SECRET_KEY=

# Required for signed payment webhook verification (separate dashboard webhook secret).
RAZORPAY_WEBHOOK_SECRET=
# Set false to operate reconciliation exclusively via npm run reconcile:payments.
PAYMENT_RECONCILIATION_ENABLED=true
