# Runtime
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Database
# Production (NODE_ENV=production) uses DATABASE_URL with SSL.
DATABASE_URL=
# Local development uses the discrete settings below.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=taskgenie
DB_USER=postgres
DB_PASSWORD=

# Auth. Required: the server signs and verifies every JWT with this.
JWT_SECRET=change_me
GOOGLE_CLIENT_ID=

# Optional integrations. Each one degrades gracefully when left blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TURNSTILE_SECRET_KEY=
